{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "backend.logs.UtcDefaultFormatter",
      "fmt": "%(asctime)s.%(msecs)03dZ %(levelprefix)s %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S",
      "use_colors": null
    },
    "access": {
      "()": "backend.logs.UtcAccessFormatter",
      "fmt": "%(asctime)s.%(msecs)03dZ %(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S"
    }
  },
  "handlers": {
    "default": {
      "formatter": "default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": { "handlers": ["default"], "level": "INFO", "propagate": false },
    "uvicorn.error": { "level": "INFO" },
    "uvicorn.access": {
      "handlers": ["access"],
      "level": "INFO",
      "propagate": false
    }
  }
}
